# Database
DATABASE_URL=postgresql://username:password@localhost:5432/teamager

# Supabase (the server currently requires these at startup; reserved for file storage)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# JWT Secrets
JWT_SECRET=your-jwt-secret-here

# Email Configuration
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=your-email@gmail.com
EMAIL_PASS=your-app-password

# Server Configuration
PORT=3001
NODE_ENV=development

# --- Deployment ---------------------------------------------------------
# Public URL of the frontend. Used for CORS, CSRF origin checks, the WebSocket
# origin check and links in emails. In production (NODE_ENV=production) only
# this and ALLOWED_ORIGINS are accepted; localhost origins are development-only.
FRONTEND_URL=http://localhost:3000
# Extra allowed browser origins, comma separated (for example preview URLs)
# ALLOWED_ORIGINS=https://preview.example.com

# Auth cookies. In production they are Secure; SameSite defaults to "none" so the
# frontend and API can be on different domains. If both are on the same site
# (app.example.com + api.example.com) use "lax" and optionally a shared domain.
# COOKIE_SAMESITE=lax
# COOKIE_DOMAIN=.example.com

# Email verification is off by default (accounts work right away). Set to true to send a
# verification email on signup; needs working EMAIL_* settings.
# EMAIL_VERIFICATION=true

# Number of proxies in front of the server (default 1 in production). Needed so
# the real client IP and https are detected behind a load balancer / platform router.
# TRUST_PROXY=1